  },
  "dependencies": {
    "@actions/core": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vercel/ncc": "^0.38.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChangesWatch/upgrade-verdict.git"
  },
  "homepage": "https://www.changes.watch/packages/how-verdicts-work"
}
