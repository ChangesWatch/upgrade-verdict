{
  "name": "@changes-watch/upgrade-verdict",
  "version": "1.0.0",
  "private": true,
  "description": "Upgrade verdicts for npm dependency changes in pull requests, powered by Changes.Watch.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/action.ts -o dist --license licenses.txt",
